>\"</span>markdown-demo-data<span class=\"token punctuation\">\"</span></span><span class=\"token punctuation\">></span></span>{{ attributes['data-info'] || textContent }}<span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;/</span>span</span><span class=\"token punctuation\">></span></span>\n    <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;/</span>ng-template</span><span class=\"token punctuation\">></span></span>\n  `</span></span><span class=\"token punctuation\">,</span>\n  styles<span class=\"token operator\">:</span> `\n    <span class=\"token punctuation\">.</span>markdown<span class=\"token operator\">-</span>demo<span class=\"token operator\">-</span>data <span class=\"token punctuation\">{</span>\n      display<span class=\"token operator\">:</span> inline<span class=\"token operator\">-</span>flex<span class=\"token punctuation\">;</span>\n      padding<span class=\"token operator\">:</span> 2px 8px<span class=\"token punctuation\">;</span>\n      color<span class=\"token operator\">:</span> #0958d9<span class=\"token punctuation\">;</span>\n      background<span class=\"token operator\">:</span> #e6f4ff<span class=\"token punctuation\">;</span>\n      border<span class=\"token operator\">:</span> 1px solid #91caff<span class=\"token punctuation\">;</span>\n      border<span class=\"token operator\">-</span>radius<span class=\"token operator\">:</span> 4px<span class=\"token punctuation\">;</span>\n    <span class=\"token punctuation\">}</span>\n  `<span class=\"token punctuation\">,</span>\n  changeDetection<span class=\"token operator\">:</span> ChangeDetectionStrategy<span class=\"token punctuation\">.</span>OnPush\n<span class=\"token punctuation\">}</span><span class=\"token punctuation\">)</span>\n<span class=\"token keyword\">export</span> <span class=\"token keyword\">class</span> <span class=\"token class-name\">NxDemoXMarkdownRendererComponent</span> <span class=\"token punctuation\">{</span>\n  <span class=\"token keyword\">readonly</span> dataTpl <span class=\"token operator\">=</span> <span class=\"token generic-function\"><span class=\"token function\">viewChild</span><span class=\"token generic class-name\"><span class=\"token operator\">&lt;</span>TemplateRef<span class=\"token operator\">&lt;</span>NxMarkdownComponentTemplateContext<span class=\"token operator\">>></span></span></span><span class=\"token punctuation\">(</span><span class=\"token string\">'dataTpl'</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n\n  <span class=\"token keyword\">readonly</span> content <span class=\"token operator\">=</span> `\n# Renderer\n\nData node<span class=\"token operator\">:</span> <span class=\"token operator\">==</span>business metric<span class=\"token operator\">==</span>\n`<span class=\"token punctuation\">;</span>\n\n  <span class=\"token keyword\">readonly</span> config<span class=\"token operator\">:</span> MarkedExtension <span class=\"token operator\">=</span> <span class=\"token punctuation\">{</span>\n    renderer<span class=\"token operator\">:</span> <span class=\"token punctuation\">{</span>\n      <span class=\"token function\">heading</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">{</span> tokens<span class=\"token punctuation\">,</span> depth <span class=\"token punctuation\">}</span><span class=\"token punctuation\">)</span> <span class=\"token punctuation\">{</span>\n        <span class=\"token keyword\">const</span> text <span class=\"token operator\">=</span> <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span>parser<span class=\"token punctuation\">.</span><span class=\"token function\">parseInline</span><span class=\"token punctuation\">(</span>tokens<span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n        <span class=\"token keyword\">return</span> `<span class=\"token operator\">&lt;</span>h$<span class=\"token punctuation\">{</span>depth<span class=\"token punctuation\">}</span><span class=\"token operator\">></span>🚀 $<span class=\"token punctuation\">{</span>text<span class=\"token punctuation\">}</span><span class=\"token operator\">&lt;</span><span class=\"token operator\">/</span>h$<span class=\"token punctuation\">{</span>depth<span class=\"token punctuation\">}</span><span class=\"token operator\">></span>`<span class=\"token punctuation\">;</span>\n      <span class=\"token punctuation\">}</span><span class=\"token punctuation\">,</span>\n      <span class=\"token function\">codespan</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">{</span> text <span class=\"token punctuation\">}</span><span class=\"token punctuation\">)</span> <span class=\"token punctuation\">{</span>\n        <span class=\"token keyword\">return</span> `<span class=\"token operator\">&lt;</span>data data<span class=\"token operator\">-</span>info<span class=\"token operator\">=</span><span class=\"token string\">\"${text}\"</span><span class=\"token operator\">></span><span class=\"token operator\">&lt;</span><span class=\"token operator\">/</span>data<span class=\"token operator\">></span>`<span class=\"token punctuation\">;</span>\n      <span class=\"token punctuation\">}</span>\n    <span class=\"token punctuation\">}</span>\n  <span class=\"token punctuation\">}</span><span class=\"token punctuation\">;</span>\n\n  <span class=\"token keyword\">readonly</span> components <span class=\"token operator\">=</span> <span class=\"token generic-function\"><span class=\"token function\">computed</span><span class=\"token generic class-name\"><span class=\"token operator\">&lt;</span>NxMarkdownComponents <span class=\"token operator\">|</span> <span class=\"token keyword\">null</span><span class=\"token operator\">></span></span></span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span> <span class=\"token operator\">=></span> <span class=\"token punctuation\">{</span>\n    <span class=\"token keyword\">const</span> dataTpl <span class=\"token operator\">=</span> <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span><span class=\"token function\">dataTpl</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n    <span class=\"token keyword\">return</span> dataTpl <span class=\"token operator\">?</span> <span class=\"token punctuation\">{</span> data<span class=\"token operator\">:</span> dataTpl <span class=\"token punctuation\">}</span> <span class=\"token operator\">:</span> <span class=\"token keyword\">null</span><span class=\"token punctuation\">;</span>\n  <span class=\"token punctuation\">}</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n<span class=\"token punctuation\">}</span>\n","rawCode":"import { ChangeDetectionStrategy, Component, TemplateRef, computed, viewChild } from '@angular/core';\n\nimport { MarkedExtension } from 'marked';\n\nimport { NxMarkdownComponent, NxMarkdownComponentTemplateContext, NxMarkdownComponents } from 'ng-zorro-x/x-markdown';\n\n@Component({\n  selector: 'nx-demo-x-markdown-renderer',\n  imports: [NxMarkdownComponent],\n  template: `\n    <nx-markdown class=\"x-markdown-light\" [content]=\"content\" [config]=\"config\" [components]=\"components()\" />\n\n    <ng-template #dataTpl let-textContent=\"textContent\" let-attributes=\"attributes\">\n      <span class=\"markdown-demo-data\">{{ attributes['data-info'] || textContent }}</span>\n    </ng-template>\n  `,\n  styles: `\n    .markdown-demo-data {\n      display: inline-flex;\n      padding: 2px 8px;\n      color: #0958d9;\n      background: #e6f4ff;\n      border: 1px solid #91caff;\n      border-radius: 4px;\n    }\n  `,\n  changeDetection: ChangeDetectionStrategy.OnPush\n})\nexport class NxDemoXMarkdownRendererComponent {\n  readonly dataTpl = viewChild<TemplateRef<NxMarkdownComponentTemplateContext>>('dataTpl');\n\n  readonly content = `\n# Renderer\n\nData node: ==business metric==\n`;\n\n  readonly config: MarkedExtension = {\n    renderer: {\n      heading({ tokens, depth }) {\n        const text = this.parser.parseInline(tokens);\n        return `<h${depth}>🚀 ${text}</h${depth}>`;\n      },\n      codespan({ text }) {\n        return `<data data-info=\"${text}\"></data>`;\n      }\n    }\n  };\n\n  readonly components = computed<NxMarkdownComponents | null>(() => {\n    const dataTpl = this.dataTpl();\n    return dataTpl ? { data: dataTpl } : null;\n  });\n}\n"}
