lass=\"token operator\">:</span> <span class=\"token string\">'Operation 1'</span><span class=\"token punctuation\">,</span>\n        key<span class=\"token operator\">:</span> <span class=\"token string\">'operation1'</span><span class=\"token punctuation\">,</span>\n        icon<span class=\"token operator\">:</span> <span class=\"token string\">'edit'</span>\n      <span class=\"token punctuation\">}</span><span class=\"token punctuation\">,</span>\n      <span class=\"token punctuation\">{</span>\n        label<span class=\"token operator\">:</span> <span class=\"token string\">'Operation 2'</span><span class=\"token punctuation\">,</span>\n        key<span class=\"token operator\">:</span> <span class=\"token string\">'operation2'</span><span class=\"token punctuation\">,</span>\n        icon<span class=\"token operator\">:</span> <span class=\"token string\">'stop'</span><span class=\"token punctuation\">,</span>\n        disabled<span class=\"token operator\">:</span> <span class=\"token boolean\">true</span>\n      <span class=\"token punctuation\">}</span><span class=\"token punctuation\">,</span>\n      <span class=\"token punctuation\">{</span>\n        label<span class=\"token operator\">:</span> <span class=\"token string\">'Operation 3'</span><span class=\"token punctuation\">,</span>\n        key<span class=\"token operator\">:</span> <span class=\"token string\">'operation3'</span><span class=\"token punctuation\">,</span>\n        icon<span class=\"token operator\">:</span> <span class=\"token string\">'delete'</span><span class=\"token punctuation\">,</span>\n        danger<span class=\"token operator\">:</span> <span class=\"token boolean\">true</span>\n      <span class=\"token punctuation\">}</span>\n    <span class=\"token punctuation\">]</span><span class=\"token punctuation\">,</span>\n    <span class=\"token function-variable function\">onClick</span><span class=\"token operator\">:</span> <span class=\"token punctuation\">(</span>info<span class=\"token operator\">:</span> <span class=\"token punctuation\">{</span> key<span class=\"token operator\">:</span> <span class=\"token builtin\">string</span><span class=\"token punctuation\">;</span> domEvent<span class=\"token operator\">:</span> Event <span class=\"token punctuation\">}</span><span class=\"token punctuation\">)</span> <span class=\"token operator\">=></span> <span class=\"token punctuation\">{</span>\n      info<span class=\"token punctuation\">.</span>domEvent<span class=\"token punctuation\">.</span><span class=\"token function\">stopPropagation</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n      <span class=\"token builtin\">console</span><span class=\"token punctuation\">.</span><span class=\"token function\">log</span><span class=\"token punctuation\">(</span>`Click $<span class=\"token punctuation\">{</span>info<span class=\"token punctuation\">.</span>key<span class=\"token punctuation\">}</span>`<span class=\"token punctuation\">,</span> conversation<span class=\"token punctuation\">.</span>key<span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n    <span class=\"token punctuation\">}</span>\n  <span class=\"token punctuation\">}</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n<span class=\"token punctuation\">}</span>\n","rawCode":"import { Component } from '@angular/core';\n\nimport { NxConversation, NxConversationMenuProps, NxConversationsModule } from 'ng-zorro-x/conversations';\n\n@Component({\n  selector: 'nx-demo-conversations-with-menu',\n  imports: [NxConversationsModule],\n  template: `\n    <ul class=\"container-background\" nx-conversations defaultActiveKey=\"item1\" [menu]=\"menu\" [items]=\"items\"></ul>\n  `,\n  styles: `\n    .ant-conversations {\n      width: 256px;\n      border-radius: 6px;\n    }\n  `\n})\nexport class NxDemoConversationsWithMenuComponent {\n  readonly items: NxConversation[] = Array.from({ length: 4 }).map((_, index) => ({\n    key: `item${index + 1}`,\n    label: `Conversation Item ${index + 1}`,\n    disabled: index === 3\n  }));\n\n  readonly menu = (conversation: NxConversation): NxConversationMenuProps => ({\n    items: [\n      {\n        label: 'Operation 1',\n        key: 'operation1',\n        icon: 'edit'\n      },\n      {\n        label: 'Operation 2',\n        key: 'operation2',\n        icon: 'stop',\n        disabled: true\n      },\n      {\n        label: 'Operation 3',\n        key: 'operation3',\n        icon: 'delete',\n        danger: true\n      }\n    ],\n    onClick: (info: { key: string; domEvent: Event }) => {\n      info.domEvent.stopPropagation();\n      console.log(`Click ${info.key}`, conversation.key);\n    }\n  });\n}\n"}
