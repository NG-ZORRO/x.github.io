class=\"token operator\">+</span> <span class=\"token number\">4</span><span class=\"token punctuation\">,</span> <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span><span class=\"token function\">fullContent</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">.</span>length<span class=\"token punctuation\">)</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n  <span class=\"token punctuation\">}</span>\n\n  <span class=\"token function\">reset</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span><span class=\"token operator\">:</span> <span class=\"token keyword\">void</span> <span class=\"token punctuation\">{</span>\n    <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span>index<span class=\"token punctuation\">.</span><span class=\"token function\">set</span><span class=\"token punctuation\">(</span><span class=\"token number\">1</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n  <span class=\"token punctuation\">}</span>\n\n  <span class=\"token function\">selectCase</span><span class=\"token punctuation\">(</span>index<span class=\"token operator\">:</span> <span class=\"token builtin\">number</span><span class=\"token punctuation\">)</span><span class=\"token operator\">:</span> <span class=\"token keyword\">void</span> <span class=\"token punctuation\">{</span>\n    <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span>selectedIndex<span class=\"token punctuation\">.</span><span class=\"token function\">set</span><span class=\"token punctuation\">(</span>index<span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n    <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span><span class=\"token function\">reset</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n  <span class=\"token punctuation\">}</span>\n\n  <span class=\"token function\">decode</span><span class=\"token punctuation\">(</span>value<span class=\"token operator\">:</span> <span class=\"token builtin\">string</span> <span class=\"token operator\">|</span> <span class=\"token keyword\">undefined</span><span class=\"token punctuation\">)</span><span class=\"token operator\">:</span> <span class=\"token builtin\">string</span> <span class=\"token punctuation\">{</span>\n    <span class=\"token keyword\">try</span> <span class=\"token punctuation\">{</span>\n      <span class=\"token keyword\">return</span> value <span class=\"token operator\">?</span> <span class=\"token function\">decodeURIComponent</span><span class=\"token punctuation\">(</span>value<span class=\"token punctuation\">)</span> <span class=\"token operator\">:</span> <span class=\"token string\">''</span><span class=\"token punctuation\">;</span>\n    <span class=\"token punctuation\">}</span> <span class=\"token keyword\">catch</span> <span class=\"token punctuation\">{</span>\n      <span class=\"token keyword\">return</span> <span class=\"token string\">''</span><span class=\"token punctuation\">;</span>\n    <span class=\"token punctuation\">}</span>\n  <span class=\"token punctuation\">}</span>\n<span class=\"token punctuation\">}</span>\n","rawCode":"import { ChangeDetectionStrategy, Component, TemplateRef, computed, signal, viewChild } from '@angular/core';\nimport { FormsModule } from '@angular/forms';\n\nimport { NzButtonModule } from 'ng-zorro-antd/button';\nimport { NzSelectModule } from 'ng-zorro-antd/select';\n\nimport { NxMarkdownComponent, NxMarkdownComponentTemplateContext, NxMarkdownComponents } from 'ng-zorro-x/x-markdown';\n\ninterface StreamingCase {\n  label: string;\n  content: string;\n}\n\nconst STREAMING_CASES: StreamingCase[] = [\n  { label: 'Link', content: 'Learn more: [Ant Design X](https://x.ant.design)' },\n  {\n    label: 'Image',\n    content:\n      '![Ant Design X](https://mdn.alipayobjects.com/huamei_iwk9zp/afts/img/A*eco6RrQhxbMAAAAAAAAAAAAADgCCAQ/original)'\n  },\n  { label: 'HTML', content: '<demo-card title=\"Streaming HTML\">Custom HTML is completed progressively.</demo-card>' },\n  { label: 'Table', content: '| Package | Description |\\n| --- | --- |\\n| ng-zorro-x | Angular AI UI |' },\n  { label: 'Emphasis', content: 'Streaming **bold**, *italic*, and ***both*** text.' },\n  { label: 'Inline code', content: 'Install with `npm install ng-zorro-x`.' }\n];\n\n@Component({\n  selector: 'nx-demo-x-markdown-streaming-format',\n  imports: [FormsModule, NxMarkdownComponent, NzButtonModule, NzSelectModule],\n  template: `\n    <div class=\"markdown-demo-actions\">\n      <nz-select [ngModel]=\"selectedIndex()\" (ngModelChange)=\"selectCase($event)\" nzSize=\"small\">\n        @for (item of streamingCases; track item.label) {\n          <nz-option [nzLabel]=\"item.label\" [nzValue]=\"$index\" />\n        }\n      </nz-select>\n      <button nz-button nzSize=\"small\" type=\"button\" (click)=\"next()\">Next chunk</button>\n      <button nz-button nzSize=\"small\" type=\"button\" (click)=\"reset()\">Reset</button>\n      <span>{{ content().length }} / {{ fullContent().length }}</span>\n    </div>\n\n    <div class=\"markdown-demo-format-grid\">\n      <section>\n        <h4>Markdown source</h4>\n        <pre>{{ content() }}</pre>\n      </section>\n      <section>\n        <h4>Rendered output</h4>\n        <nx-markdown\n          class=\"x-markdown-light\"\n          [content]=\"content()\"\n          [components]=\"components()\"\n          [streaming]=\"{ hasNextChunk: hasNextChunk() }\"\n        />\n      </section>\n    </div>\n\n    <ng-template #linkTpl let-attributes=\"attributes\">\n      <span class=\"markdown-demo-placeholder\">Loading link: {{ decode(attributes['data-raw']) }}</span>\n    </ng-template>\n    <ng-template #imageTpl>\n      <span class=\"markdown-demo-placeholder\">Loading image…</span>\n    </ng-template>\n    <ng-template #htmlTpl>\n      <span class=\"markdown-demo-placeholder\">Loading HTML…</span>\n    </ng-template>\n    <ng-template #tableTpl>\n      <span class=\"markdown-demo-placeholder\">Loading table…</span>\n    </ng-template>\n    <ng-template #emphasisTpl let-attributes=\"attributes\">\n      <em>{{ decode(attributes['data-raw']).slice(1) }}</em>\n    </ng-template>\n    <ng-template #inlineCodeTpl let-attributes=\"attributes\">\n      <code>{{ decode(attributes['data-raw']).slice(1) }}</code>\n    </ng-template>\n  `,\n  styles: `\n    .markdown-demo-actions {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 8px;\n      align-items: center;\n      margin-bottom: 16px;\n    }\n\n    .markdown-demo-actions > span {\n      color: rgb(0 0 0 / 45%);\n      font-size: 12px;\n    }\n\n    .markdown-demo-format-grid {\n      display: grid;\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n      gap: 16px;\n    }\n\n    .markdown-demo-format-grid section {\n      min-height: 160px;\n      padding: 12px;\n      overflow: auto;\n      border: 1px solid #f0f0f0;\n      border-radius: 6px;\n    }\n\n    .markdown-demo-format-grid h4 {\n      margin: 0 0 8px;\n    }\n\n    .markdown-demo-format-grid pre {\n      margin: 0;\n      white-space: pre-wrap;\n    }\n\n    .markdown-demo-placeholder {\n      display: inline-flex;\n      padding: 4px 8px;\n      color: #1677ff;\n      background: #e6f4ff;\n      border-radius: 4px;\n    }\n\n    @media (width <= 768px) {\n      .markdown-demo-format-grid {\n        grid-template-columns: 1fr;\n      }\n    }\n  `,\n  changeDetection: ChangeDetectionStrategy.OnPush\n})\nexport class NxDemoXMarkdownStreamingFormatComponent {\n  readonly streamingCases = STREAMING_CASES;\n  readonly selectedIndex = signal(0);\n  readonly index = signal(1);\n  readonly fullContent = computed(() => this.streamingCases[this.selectedIndex()].content);\n  readonly content = computed(() => this.fullContent().slice(0, this.index()));\n  readonly hasNextChunk = computed(() => this.index() < this.fullContent().length);\n\n  readonly linkTpl = viewChild<TemplateRef<NxMarkdownComponentTemplateContext>>('linkTpl');\n  readonly imageTpl = viewChild<TemplateRef<NxMarkdownComponentTemplateContext>>('imageTpl');\n  readonly htmlTpl = viewChild<TemplateRef<NxMarkdownComponentTemplateContext>>('htmlTpl');\n  readonly tableTpl = viewChild<TemplateRef<NxMarkdownComponentTemplateContext>>('tableTpl');\n  readonly emphasisTpl = viewChild<TemplateRef<NxMarkdownComponentTemplateContext>>('emphasisTpl');\n  readonly inlineCodeTpl = viewChild<TemplateRef<NxMarkdownComponentTemplateContext>>('inlineCodeTpl');\n  readonly components = computed<NxMarkdownComponents | null>(() => {\n    const linkTpl = this.linkTpl();\n    const imageTpl = this.imageTpl();\n    const htmlTpl = this.htmlTpl();\n    const tableTpl = this.tableTpl();\n    const emphasisTpl = this.emphasisTpl();\n    const inlineCodeTpl = this.inlineCodeTpl();\n    return linkTpl && imageTpl && htmlTpl && tableTpl && emphasisTpl && inlineCodeTpl\n      ? {\n          'incomplete-link': linkTpl,\n          'incomplete-image': imageTpl,\n          'incomplete-html': htmlTpl,\n          'incomplete-table': tableTpl,\n          'incomplete-emphasis': emphasisTpl,\n          'incomplete-inline-code': inlineCodeTpl\n        }\n      : null;\n  });\n\n  next(): void {\n    this.index.update(index => Math.min(index + 4, this.fullContent().length));\n  }\n\n  reset(): void {\n    this.index.set(1);\n  }\n\n  selectCase(index: number): void {\n    this.selectedIndex.set(index);\n    this.reset();\n  }\n\n  decode(value: string | undefined): string {\n    try {\n      return value ? decodeURIComponent(value) : '';\n    } catch {\n      return '';\n    }\n  }\n}\n"}
