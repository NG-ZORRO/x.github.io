span class=\"token punctuation\">,</span> <span class=\"token number\">20</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n  <span class=\"token punctuation\">}</span>\n\n  <span class=\"token function\">scrollToBottom</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span><span class=\"token operator\">:</span> <span class=\"token keyword\">void</span> <span class=\"token punctuation\">{</span>\n    <span class=\"token function\">queueMicrotask</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span> <span class=\"token operator\">=></span> <span class=\"token punctuation\">{</span>\n      <span class=\"token keyword\">const</span> container <span class=\"token operator\">=</span> <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span><span class=\"token function\">scrollContainer</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span><span class=\"token operator\">?.</span>nativeElement<span class=\"token punctuation\">;</span>\n      <span class=\"token keyword\">if</span> <span class=\"token punctuation\">(</span>container <span class=\"token operator\">&amp;&amp;</span> container<span class=\"token punctuation\">.</span>scrollHeight <span class=\"token operator\">></span> container<span class=\"token punctuation\">.</span>clientHeight<span class=\"token punctuation\">)</span> <span class=\"token punctuation\">{</span>\n        container<span class=\"token punctuation\">.</span><span class=\"token function\">scrollTo</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">{</span> top<span class=\"token operator\">:</span> container<span class=\"token punctuation\">.</span>scrollHeight<span class=\"token punctuation\">,</span> behavior<span class=\"token operator\">:</span> <span class=\"token string\">'smooth'</span> <span class=\"token punctuation\">}</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n      <span class=\"token punctuation\">}</span>\n    <span class=\"token punctuation\">}</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n  <span class=\"token punctuation\">}</span>\n\n  <span class=\"token function\">clearTimer</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span><span class=\"token operator\">:</span> <span class=\"token keyword\">void</span> <span class=\"token punctuation\">{</span>\n    <span class=\"token keyword\">if</span> <span class=\"token punctuation\">(</span><span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span>timer<span class=\"token punctuation\">)</span> <span class=\"token punctuation\">{</span>\n      <span class=\"token function\">clearTimeout</span><span class=\"token punctuation\">(</span><span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span>timer<span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n      <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span>timer <span class=\"token operator\">=</span> <span class=\"token keyword\">null</span><span class=\"token punctuation\">;</span>\n    <span class=\"token punctuation\">}</span>\n  <span class=\"token punctuation\">}</span>\n<span class=\"token punctuation\">}</span>\n","rawCode":"import { isPlatformBrowser } from '@angular/common';\nimport {\n  ChangeDetectionStrategy,\n  Component,\n  DestroyRef,\n  ElementRef,\n  PLATFORM_ID,\n  computed,\n  inject,\n  signal,\n  viewChild\n} from '@angular/core';\n\nimport { NzButtonModule } from 'ng-zorro-antd/button';\n\nimport { NxBubbleComponent } from 'ng-zorro-x/bubble';\nimport { NxThinkComponent } from 'ng-zorro-x/think';\nimport { NxMarkdownComponent } from 'ng-zorro-x/x-markdown';\n\nconst CONTENT = `\n<think>Deep thinking is a systematic and structured cognitive approach that requires individuals to move beyond intuition and superficial information, delving into the essence of a problem and its underlying principles through logical analysis, multi-perspective examination, and persistent inquiry. Unlike quick reactions or heuristic judgments, deep thinking emphasizes slow thinking, actively engaging knowledge reserves, critical thinking, and creativity to uncover deeper connections and meanings.\nKey characteristics of deep thinking include:\nProbing the Essence: Not settling for \"what it is,\" but continuously asking \"why\" and \"how it works\" until reaching the fundamental logic.\nMultidimensional Connections: Placing the issue in a broader context and analyzing it through interdisciplinary knowledge or diverse perspectives.\nSkepticism & Reflection: Challenging existing conclusions, authoritative opinions, and even personal biases, validating them through logic or evidence.\nLong-term Value Focus: Prioritizing systemic consequences and sustainable impact over short-term or localized benefits.\nThis mode of thinking helps individuals avoid cognitive biases in complex scenarios, improve decision-making, and generate groundbreaking insights in fields such as academic research, business innovation, and social problem-solving.</think>\n# Hello Deep Thinking\nDeep thinking is over.\n\nYou can use the think tag to package your thoughts.\n`;\n\n@Component({\n  selector: 'nx-demo-x-markdown-components-think',\n  imports: [NxBubbleComponent, NxMarkdownComponent, NxThinkComponent, NzButtonModule],\n  template: `\n    <div #scrollContainer class=\"markdown-demo-chat markdown-demo-think\">\n      <div class=\"markdown-demo-actions\">\n        <button nz-button type=\"button\" (click)=\"reRender()\">Re-Render</button>\n      </div>\n\n      <nx-bubble [content]=\"content()\" [messageRender]=\"messageTpl\" variant=\"outlined\" />\n    </div>\n\n    <ng-template #messageTpl let-content=\"content\">\n      <nx-markdown [content]=\"content\" [components]=\"{ think: thinkTpl }\" paragraphTag=\"div\" protectCustomTagNewlines />\n    </ng-template>\n\n    <ng-template #thinkTpl let-textContent=\"textContent\" let-streamStatus=\"streamStatus\">\n      @let thinking = hasNextChunk() || streamStatus === 'loading';\n      <nx-think\n        [title]=\"thinking ? 'Deep thinking...' : 'Complete thinking'\"\n        [loading]=\"thinking\"\n        [(expanded)]=\"thinkExpanded\"\n      >\n        {{ textContent }}\n      </nx-think>\n    </ng-template>\n  `,\n  styles: `\n    .markdown-demo-chat {\n      display: flex;\n      flex-direction: column;\n      gap: 8px;\n      overflow: auto;\n    }\n\n    .markdown-demo-think {\n      height: 420px;\n    }\n\n    .markdown-demo-actions {\n      display: flex;\n      justify-content: flex-end;\n    }\n  `,\n  changeDetection: ChangeDetectionStrategy.OnPush\n})\nexport class NxDemoXMarkdownComponentsThinkComponent {\n  readonly destroyRef = inject(DestroyRef);\n  readonly isBrowser = isPlatformBrowser(inject(PLATFORM_ID));\n  readonly scrollContainer = viewChild<ElementRef<HTMLElement>>('scrollContainer');\n  readonly index = signal(0);\n  readonly thinkExpanded = signal(true);\n  readonly content = computed(() => CONTENT.slice(0, this.index()));\n  readonly hasNextChunk = computed(() => this.index() < CONTENT.length);\n  timer: ReturnType<typeof setTimeout> | null = null;\n\n  constructor() {\n    if (this.isBrowser) {\n      this.renderStream();\n    }\n    this.destroyRef.onDestroy(() => this.clearTimer());\n  }\n\n  reRender(): void {\n    this.clearTimer();\n    this.index.set(0);\n    this.thinkExpanded.set(true);\n    this.renderStream();\n  }\n\n  renderStream(): void {\n    if (!this.isBrowser || this.index() >= CONTENT.length) {\n      this.thinkExpanded.set(false);\n      this.clearTimer();\n      return;\n    }\n\n    this.timer = setTimeout(() => {\n      this.index.update(index => Math.min(index + 5, CONTENT.length));\n      this.scrollToBottom();\n      this.renderStream();\n    }, 20);\n  }\n\n  scrollToBottom(): void {\n    queueMicrotask(() => {\n      const container = this.scrollContainer()?.nativeElement;\n      if (container && container.scrollHeight > container.clientHeight) {\n        container.scrollTo({ top: container.scrollHeight, behavior: 'smooth' });\n      }\n    });\n  }\n\n  clearTimer(): void {\n    if (this.timer) {\n      clearTimeout(this.timer);\n      this.timer = null;\n    }\n  }\n}\n"}
