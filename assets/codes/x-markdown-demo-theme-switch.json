tion\">\"</span></span> <span class=\"token attr-name\">[nzType]</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>mode() === 'dark' ? 'primary' : 'default'<span class=\"token punctuation\">\"</span></span> <span class=\"token attr-name\">(click)</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>setMode('dark')<span class=\"token punctuation\">\"</span></span><span class=\"token punctuation\">></span></span>\n        Dark\n      <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;/</span>button</span><span class=\"token punctuation\">></span></span>\n    <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;/</span>div</span><span class=\"token punctuation\">></span></span>\n    <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;</span>div</span> <span class=\"token attr-name\">[class.markdown-demo-dark]</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>mode() === 'dark'<span class=\"token punctuation\">\"</span></span><span class=\"token punctuation\">></span></span>\n      <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;</span>nx-markdown</span> <span class=\"token attr-name\">[content]</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>content<span class=\"token punctuation\">\"</span></span> <span class=\"token attr-name\">[class]</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>themeClass()<span class=\"token punctuation\">\"</span></span> <span class=\"token punctuation\">/></span></span>\n    <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;/</span>div</span><span class=\"token punctuation\">></span></span>\n  `</span></span><span class=\"token punctuation\">,</span>\n  styles<span class=\"token operator\">:</span> `\n    <span class=\"token punctuation\">.</span>markdown<span class=\"token operator\">-</span>demo<span class=\"token operator\">-</span>actions <span class=\"token punctuation\">{</span>\n      display<span class=\"token operator\">:</span> flex<span class=\"token punctuation\">;</span>\n      gap<span class=\"token operator\">:</span> 8px<span class=\"token punctuation\">;</span>\n      margin<span class=\"token operator\">-</span>bottom<span class=\"token operator\">:</span> 16px<span class=\"token punctuation\">;</span>\n    <span class=\"token punctuation\">}</span>\n\n    <span class=\"token punctuation\">.</span>markdown<span class=\"token operator\">-</span>demo<span class=\"token operator\">-</span>dark <span class=\"token punctuation\">{</span>\n      padding<span class=\"token operator\">:</span> 16px<span class=\"token punctuation\">;</span>\n      background<span class=\"token operator\">:</span> #<span class=\"token number\">141414</span><span class=\"token punctuation\">;</span>\n      border<span class=\"token operator\">-</span>radius<span class=\"token operator\">:</span> 6px<span class=\"token punctuation\">;</span>\n    <span class=\"token punctuation\">}</span>\n  `<span class=\"token punctuation\">,</span>\n  changeDetection<span class=\"token operator\">:</span> ChangeDetectionStrategy<span class=\"token punctuation\">.</span>OnPush\n<span class=\"token punctuation\">}</span><span class=\"token punctuation\">)</span>\n<span class=\"token keyword\">export</span> <span class=\"token keyword\">class</span> <span class=\"token class-name\">NxDemoXMarkdownThemeSwitchComponent</span> <span class=\"token punctuation\">{</span>\n  <span class=\"token keyword\">readonly</span> content <span class=\"token operator\">=</span> <span class=\"token constant\">THEME_MARKDOWN</span><span class=\"token punctuation\">;</span>\n  <span class=\"token keyword\">readonly</span> mode <span class=\"token operator\">=</span> <span class=\"token generic-function\"><span class=\"token function\">signal</span><span class=\"token generic class-name\"><span class=\"token operator\">&lt;</span><span class=\"token string\">'light'</span> <span class=\"token operator\">|</span> <span class=\"token string\">'dark'</span><span class=\"token operator\">></span></span></span><span class=\"token punctuation\">(</span><span class=\"token string\">'light'</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n  <span class=\"token keyword\">readonly</span> themeClass <span class=\"token operator\">=</span> <span class=\"token function\">computed</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span> <span class=\"token operator\">=></span> <span class=\"token punctuation\">(</span><span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span><span class=\"token function\">mode</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span> <span class=\"token operator\">===</span> <span class=\"token string\">'light'</span> <span class=\"token operator\">?</span> <span class=\"token string\">'x-markdown-light'</span> <span class=\"token operator\">:</span> <span class=\"token string\">'x-markdown-dark'</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n\n  <span class=\"token function\">setMode</span><span class=\"token punctuation\">(</span>mode<span class=\"token operator\">:</span> <span class=\"token string\">'light'</span> <span class=\"token operator\">|</span> <span class=\"token string\">'dark'</span><span class=\"token punctuation\">)</span><span class=\"token operator\">:</span> <span class=\"token keyword\">void</span> <span class=\"token punctuation\">{</span>\n    <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span>mode<span class=\"token punctuation\">.</span><span class=\"token function\">set</span><span class=\"token punctuation\">(</span>mode<span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n  <span class=\"token punctuation\">}</span>\n<span class=\"token punctuation\">}</span>\n","rawCode":"import { ChangeDetectionStrategy, Component, computed, signal } from '@angular/core';\n\nimport { NzButtonModule } from 'ng-zorro-antd/button';\n\nimport { NxMarkdownComponent } from 'ng-zorro-x/x-markdown';\n\nimport { THEME_MARKDOWN } from './shared';\n\n@Component({\n  selector: 'nx-demo-x-markdown-theme-switch',\n  imports: [NxMarkdownComponent, NzButtonModule],\n  template: `\n    <div class=\"markdown-demo-actions\">\n      <button nz-button type=\"button\" [nzType]=\"mode() === 'light' ? 'primary' : 'default'\" (click)=\"setMode('light')\">\n        Light\n      </button>\n      <button nz-button type=\"button\" [nzType]=\"mode() === 'dark' ? 'primary' : 'default'\" (click)=\"setMode('dark')\">\n        Dark\n      </button>\n    </div>\n    <div [class.markdown-demo-dark]=\"mode() === 'dark'\">\n      <nx-markdown [content]=\"content\" [class]=\"themeClass()\" />\n    </div>\n  `,\n  styles: `\n    .markdown-demo-actions {\n      display: flex;\n      gap: 8px;\n      margin-bottom: 16px;\n    }\n\n    .markdown-demo-dark {\n      padding: 16px;\n      background: #141414;\n      border-radius: 6px;\n    }\n  `,\n  changeDetection: ChangeDetectionStrategy.OnPush\n})\nexport class NxDemoXMarkdownThemeSwitchComponent {\n  readonly content = THEME_MARKDOWN;\n  readonly mode = signal<'light' | 'dark'>('light');\n  readonly themeClass = computed(() => (this.mode() === 'light' ? 'x-markdown-light' : 'x-markdown-dark'));\n\n  setMode(mode: 'light' | 'dark'): void {\n    this.mode.set(mode);\n  }\n}\n"}
