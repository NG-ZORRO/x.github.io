nts]</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>components()<span class=\"token punctuation\">\"</span></span> <span class=\"token attr-name\">protectCustomTagNewlines</span> <span class=\"token punctuation\">/></span></span>\n\n    <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;</span>ng-template</span> <span class=\"token attr-name\">#alertTpl</span> <span class=\"token attr-name\">let-textContent</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>textContent<span class=\"token punctuation\">\"</span></span> <span class=\"token attr-name\">let-streamStatus</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>streamStatus<span class=\"token punctuation\">\"</span></span><span class=\"token punctuation\">></span></span>\n      <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;</span>span</span> <span class=\"token attr-name\">class</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>markdown-demo-alert<span class=\"token punctuation\">\"</span></span> <span class=\"token attr-name\">[class.markdown-demo-alert-loading]</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>streamStatus === 'loading'<span class=\"token punctuation\">\"</span></span><span class=\"token punctuation\">></span></span>\n        {{ textContent }}\n      <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;/</span>span</span><span class=\"token punctuation\">></span></span>\n    <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;/</span>ng-template</span><span class=\"token punctuation\">></span></span>\n  `</span></span><span class=\"token punctuation\">,</span>\n  styles<span class=\"token operator\">:</span> `\n    <span class=\"token punctuation\">.</span>markdown<span class=\"token operator\">-</span>demo<span class=\"token operator\">-</span>alert <span class=\"token punctuation\">{</span>\n      display<span class=\"token operator\">:</span> inline<span class=\"token operator\">-</span>flex<span class=\"token punctuation\">;</span>\n      padding<span class=\"token operator\">:</span> 2px 8px<span class=\"token punctuation\">;</span>\n      border<span class=\"token operator\">:</span> 1px solid #91caff<span class=\"token punctuation\">;</span>\n      border<span class=\"token operator\">-</span>radius<span class=\"token operator\">:</span> 4px<span class=\"token punctuation\">;</span>\n      color<span class=\"token operator\">:</span> #0958d9<span class=\"token punctuation\">;</span>\n      background<span class=\"token operator\">:</span> #e6f4ff<span class=\"token punctuation\">;</span>\n    <span class=\"token punctuation\">}</span>\n\n    <span class=\"token punctuation\">.</span>markdown<span class=\"token operator\">-</span>demo<span class=\"token operator\">-</span>alert<span class=\"token operator\">-</span>loading <span class=\"token punctuation\">{</span>\n      border<span class=\"token operator\">-</span>style<span class=\"token operator\">:</span> dashed<span class=\"token punctuation\">;</span>\n    <span class=\"token punctuation\">}</span>\n  `<span class=\"token punctuation\">,</span>\n  changeDetection<span class=\"token operator\">:</span> ChangeDetectionStrategy<span class=\"token punctuation\">.</span>OnPush\n<span class=\"token punctuation\">}</span><span class=\"token punctuation\">)</span>\n<span class=\"token keyword\">export</span> <span class=\"token keyword\">class</span> <span class=\"token class-name\">NxDemoXMarkdownCustomComponent</span> <span class=\"token punctuation\">{</span>\n  <span class=\"token keyword\">readonly</span> alertTpl <span class=\"token operator\">=</span> <span class=\"token generic-function\"><span class=\"token function\">viewChild</span><span class=\"token generic class-name\"><span class=\"token operator\">&lt;</span>TemplateRef<span class=\"token operator\">&lt;</span>NxMarkdownComponentTemplateContext<span class=\"token operator\">>></span></span></span><span class=\"token punctuation\">(</span><span class=\"token string\">'alertTpl'</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n  <span class=\"token keyword\">readonly</span> content <span class=\"token operator\">=</span> <span class=\"token string\">'Render a &lt;demo-alert>custom component&lt;/demo-alert> in Markdown.'</span><span class=\"token punctuation\">;</span>\n  <span class=\"token keyword\">readonly</span> components <span class=\"token operator\">=</span> <span class=\"token generic-function\"><span class=\"token function\">computed</span><span class=\"token generic class-name\"><span class=\"token operator\">&lt;</span>NxMarkdownComponents <span class=\"token operator\">|</span> <span class=\"token keyword\">null</span><span class=\"token operator\">></span></span></span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span> <span class=\"token operator\">=></span> <span class=\"token punctuation\">{</span>\n    <span class=\"token keyword\">const</span> alertTpl <span class=\"token operator\">=</span> <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span><span class=\"token function\">alertTpl</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n    <span class=\"token keyword\">return</span> alertTpl\n      <span class=\"token operator\">?</span> <span class=\"token punctuation\">{</span>\n          <span class=\"token string-property property\">'demo-alert'</span><span class=\"token operator\">:</span> alertTpl\n        <span class=\"token punctuation\">}</span>\n      <span class=\"token operator\">:</span> <span class=\"token keyword\">null</span><span class=\"token punctuation\">;</span>\n  <span class=\"token punctuation\">}</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n<span class=\"token punctuation\">}</span>\n","rawCode":"import { ChangeDetectionStrategy, Component, TemplateRef, computed, viewChild } from '@angular/core';\n\nimport { NxMarkdownComponent, NxMarkdownComponents, NxMarkdownComponentTemplateContext } from 'ng-zorro-x/x-markdown';\n\n@Component({\n  selector: 'nx-demo-x-markdown-custom',\n  imports: [NxMarkdownComponent],\n  template: `\n    <nx-markdown [content]=\"content\" [components]=\"components()\" protectCustomTagNewlines />\n\n    <ng-template #alertTpl let-textContent=\"textContent\" let-streamStatus=\"streamStatus\">\n      <span class=\"markdown-demo-alert\" [class.markdown-demo-alert-loading]=\"streamStatus === 'loading'\">\n        {{ textContent }}\n      </span>\n    </ng-template>\n  `,\n  styles: `\n    .markdown-demo-alert {\n      display: inline-flex;\n      padding: 2px 8px;\n      border: 1px solid #91caff;\n      border-radius: 4px;\n      color: #0958d9;\n      background: #e6f4ff;\n    }\n\n    .markdown-demo-alert-loading {\n      border-style: dashed;\n    }\n  `,\n  changeDetection: ChangeDetectionStrategy.OnPush\n})\nexport class NxDemoXMarkdownCustomComponent {\n  readonly alertTpl = viewChild<TemplateRef<NxMarkdownComponentTemplateContext>>('alertTpl');\n  readonly content = 'Render a <demo-alert>custom component</demo-alert> in Markdown.';\n  readonly components = computed<NxMarkdownComponents | null>(() => {\n    const alertTpl = this.alertTpl();\n    return alertTpl\n      ? {\n          'demo-alert': alertTpl\n        }\n      : null;\n  });\n}\n"}
