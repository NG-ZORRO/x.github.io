class=\"token function\">min</span><span class=\"token punctuation\">(</span>value <span class=\"token operator\">+</span> <span class=\"token number\">1</span><span class=\"token punctuation\">,</span> <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span>chunks<span class=\"token punctuation\">.</span>length<span class=\"token punctuation\">)</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n  <span class=\"token punctuation\">}</span>\n\n  <span class=\"token function\">reset</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span><span class=\"token operator\">:</span> <span class=\"token keyword\">void</span> <span class=\"token punctuation\">{</span>\n    <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span>index<span class=\"token punctuation\">.</span><span class=\"token function\">set</span><span class=\"token punctuation\">(</span><span class=\"token number\">1</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n  <span class=\"token punctuation\">}</span>\n\n  <span class=\"token function\">setAnimationEnabled</span><span class=\"token punctuation\">(</span>enabled<span class=\"token operator\">:</span> <span class=\"token builtin\">boolean</span><span class=\"token punctuation\">)</span><span class=\"token operator\">:</span> <span class=\"token keyword\">void</span> <span class=\"token punctuation\">{</span>\n    <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span>enableAnimation<span class=\"token punctuation\">.</span><span class=\"token function\">set</span><span class=\"token punctuation\">(</span>enabled<span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n  <span class=\"token punctuation\">}</span>\n\n  <span class=\"token function\">setTailEnabled</span><span class=\"token punctuation\">(</span>enabled<span class=\"token operator\">:</span> <span class=\"token builtin\">boolean</span><span class=\"token punctuation\">)</span><span class=\"token operator\">:</span> <span class=\"token keyword\">void</span> <span class=\"token punctuation\">{</span>\n    <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span>enableTail<span class=\"token punctuation\">.</span><span class=\"token function\">set</span><span class=\"token punctuation\">(</span>enabled<span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n  <span class=\"token punctuation\">}</span>\n<span class=\"token punctuation\">}</span>\n","rawCode":"import { ChangeDetectionStrategy, Component, computed, signal } from '@angular/core';\nimport { FormsModule } from '@angular/forms';\n\nimport { NzButtonModule } from 'ng-zorro-antd/button';\nimport { NzSwitchModule } from 'ng-zorro-antd/switch';\n\nimport { NxMarkdownComponent } from 'ng-zorro-x/x-markdown';\n\nimport { ADX_MARKDOWN, sliceContent } from './shared';\n\n@Component({\n  selector: 'nx-demo-x-markdown-streaming-animation',\n  imports: [FormsModule, NxMarkdownComponent, NzButtonModule, NzSwitchModule],\n  template: `\n    <div class=\"markdown-demo-actions\">\n      <label>\n        <span>Animation</span>\n        <nz-switch nzSize=\"small\" [ngModel]=\"enableAnimation()\" (ngModelChange)=\"setAnimationEnabled($event)\" />\n      </label>\n      <label>\n        <span>Tail</span>\n        <nz-switch nzSize=\"small\" [ngModel]=\"enableTail()\" (ngModelChange)=\"setTailEnabled($event)\" />\n      </label>\n      <button nz-button type=\"button\" (click)=\"next()\">Next chunk</button>\n      <button nz-button type=\"button\" (click)=\"reset()\">Reset</button>\n    </div>\n    <nx-markdown\n      class=\"x-markdown-light\"\n      [content]=\"content()\"\n      [streaming]=\"{ hasNextChunk: hasNextChunk(), enableAnimation: enableAnimation(), tail: tail() }\"\n    />\n  `,\n  styles: `\n    .markdown-demo-actions {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 12px;\n      margin-bottom: 16px;\n    }\n\n    .markdown-demo-actions label {\n      display: inline-flex;\n      align-items: center;\n      gap: 8px;\n    }\n  `,\n  changeDetection: ChangeDetectionStrategy.OnPush\n})\nexport class NxDemoXMarkdownStreamingAnimationComponent {\n  readonly chunks = sliceContent(ADX_MARKDOWN, 100);\n  readonly index = signal(1);\n  readonly enableAnimation = signal(true);\n  readonly enableTail = signal(true);\n  readonly content = computed(() => this.chunks.slice(0, this.index()).join(''));\n  readonly hasNextChunk = computed(() => this.index() < this.chunks.length);\n  readonly tail = computed(() => (this.enableTail() ? { content: '▋' } : false));\n\n  next(): void {\n    this.index.update(value => Math.min(value + 1, this.chunks.length));\n  }\n\n  reset(): void {\n    this.index.set(1);\n  }\n\n  setAnimationEnabled(enabled: boolean): void {\n    this.enableAnimation.set(enabled);\n  }\n\n  setTailEnabled(enabled: boolean): void {\n    this.enableTail.set(enabled);\n  }\n}\n"}
