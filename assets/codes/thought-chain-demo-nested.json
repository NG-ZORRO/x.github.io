 Thought Chain Item Footer</button>\n    </ng-template>\n    <ng-template #footer2>\n      <button nz-button>2 - Thought Chain Item Footer</button>\n    </ng-template>\n  `\n})\nexport class NxDemoThoughtChainNestedComponent implements OnInit {\n  @ViewChild('content1', { static: true }) contentElement1!: TemplateRef<void>;\n  @ViewChild('content2', { static: true }) contentElement2!: TemplateRef<void>;\n  @ViewChild('footer1', { static: true }) footerElement1!: TemplateRef<void>;\n  @ViewChild('footer2', { static: true }) footerElement2!: TemplateRef<void>;\n\n  nxItems: NxThoughtChainItem[] = [];\n\n  readonly nxItems1: NxThoughtChainItem[] = [\n    {\n      title: '1-1 Thought Chain Item',\n      description: 'description'\n    },\n    {\n      title: '1-2 Thought Chain Item',\n      description: 'description'\n    }\n  ];\n\n  readonly nxItems2: NxThoughtChainItem[] = [\n    {\n      title: '2-1 Thought Chain Item',\n      description: 'description'\n    },\n    {\n      title: '2-2 Thought Chain Item',\n      description: 'description'\n    },\n    {\n      title: '2-3 Thought Chain Item',\n      description: 'description'\n    }\n  ];\n\n  ngOnInit(): void {\n    this.nxItems = [\n      {\n        title: '1 - Thought Chain Item',\n        description: 'description',\n        content: this.contentElement1,\n        footer: this.footerElement1\n      },\n      {\n        title: '2 - Thought Chain Item',\n        description: 'description',\n        content: this.contentElement2,\n        footer: this.footerElement2\n      }\n    ];\n  }\n}\n"}
