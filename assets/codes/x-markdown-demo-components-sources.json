ion\">.</span><span class=\"token function\">index</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span> <span class=\"token operator\">>=</span> <span class=\"token constant\">CONTENT</span><span class=\"token punctuation\">.</span>length<span class=\"token punctuation\">)</span> <span class=\"token punctuation\">{</span>\n      <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span><span class=\"token function\">clearTimer</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n      <span class=\"token keyword\">return</span><span class=\"token punctuation\">;</span>\n    <span class=\"token punctuation\">}</span>\n\n    <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span>timer <span class=\"token operator\">=</span> <span class=\"token function\">setTimeout</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span> <span class=\"token operator\">=></span> <span class=\"token punctuation\">{</span>\n      <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span>index<span class=\"token punctuation\">.</span><span class=\"token function\">update</span><span class=\"token punctuation\">(</span>index <span class=\"token operator\">=></span> Math<span class=\"token punctuation\">.</span><span class=\"token function\">min</span><span class=\"token punctuation\">(</span>index <span class=\"token operator\">+</span> <span class=\"token number\">5</span><span class=\"token punctuation\">,</span> <span class=\"token constant\">CONTENT</span><span class=\"token punctuation\">.</span>length<span class=\"token punctuation\">)</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n      <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span><span class=\"token function\">scrollToBottom</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n      <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span><span class=\"token function\">renderStream</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n    <span class=\"token punctuation\">}</span><span class=\"token punctuation\">,</span> <span class=\"token number\">20</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n  <span class=\"token punctuation\">}</span>\n\n  <span class=\"token function\">scrollToBottom</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span><span class=\"token operator\">:</span> <span class=\"token keyword\">void</span> <span class=\"token punctuation\">{</span>\n    <span class=\"token function\">queueMicrotask</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span> <span class=\"token operator\">=></span> <span class=\"token punctuation\">{</span>\n      <span class=\"token keyword\">const</span> container <span class=\"token operator\">=</span> <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span><span class=\"token function\">scrollContainer</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span><span class=\"token operator\">?.</span>nativeElement<span class=\"token punctuation\">;</span>\n      <span class=\"token keyword\">if</span> <span class=\"token punctuation\">(</span>container <span class=\"token operator\">&amp;&amp;</span> container<span class=\"token punctuation\">.</span>scrollHeight <span class=\"token operator\">></span> container<span class=\"token punctuation\">.</span>clientHeight<span class=\"token punctuation\">)</span> <span class=\"token punctuation\">{</span>\n        container<span class=\"token punctuation\">.</span><span class=\"token function\">scrollTo</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">{</span> top<span class=\"token operator\">:</span> container<span class=\"token punctuation\">.</span>scrollHeight<span class=\"token punctuation\">,</span> behavior<span class=\"token operator\">:</span> <span class=\"token string\">'smooth'</span> <span class=\"token punctuation\">}</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n      <span class=\"token punctuation\">}</span>\n    <span class=\"token punctuation\">}</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n  <span class=\"token punctuation\">}</span>\n\n  <span class=\"token function\">clearTimer</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span><span class=\"token operator\">:</span> <span class=\"token keyword\">void</span> <span class=\"token punctuation\">{</span>\n    <span class=\"token keyword\">if</span> <span class=\"token punctuation\">(</span><span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span>timer<span class=\"token punctuation\">)</span> <span class=\"token punctuation\">{</span>\n      <span class=\"token function\">clearTimeout</span><span class=\"token punctuation\">(</span><span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span>timer<span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n      <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span>timer <span class=\"token operator\">=</span> <span class=\"token keyword\">null</span><span class=\"token punctuation\">;</span>\n    <span class=\"token punctuation\">}</span>\n  <span class=\"token punctuation\">}</span>\n<span class=\"token punctuation\">}</span>\n","rawCode":"import { isPlatformBrowser } from '@angular/common';\nimport {\n  ChangeDetectionStrategy,\n  Component,\n  DestroyRef,\n  ElementRef,\n  PLATFORM_ID,\n  computed,\n  inject,\n  signal,\n  viewChild\n} from '@angular/core';\n\nimport { NzButtonModule } from 'ng-zorro-antd/button';\n\nimport { NxBubbleComponent } from 'ng-zorro-x/bubble';\nimport { NxMarkdownComponent } from 'ng-zorro-x/x-markdown';\n\nconst CONTENT =\n  'Ant Financial has a large number of enterprise-level products.<sup>1</sup> With complex scenarios, designers and developers often need to respond fast due to frequent changes in product demands and concurrent R & D workflow.<sup>2</sup> Many similar contents exist in the process. Through abstraction, we could obtain some stable and highly reusable components and pages.<sup>3</sup>';\n\nconst SOURCE_ITEMS: Record<string, { title: string; url: string; description?: string }> = {\n  1: {\n    title: '1. Data source',\n    url: 'https://x.ant.design/components/overview',\n    description:\n      'Artificial Intelligence, often abbreviated as AI, is a broad branch of computer science concerned with building smart machines capable of performing tasks that typically require human intelligence.'\n  },\n  2: {\n    title: '2. Data source',\n    url: 'https://x.ant.design/components/overview'\n  },\n  3: {\n    title: '3. Data source',\n    url: 'https://x.ant.design/components/overview'\n  }\n};\n\n@Component({\n  selector: 'nx-demo-x-markdown-components-sources',\n  imports: [NxBubbleComponent, NxMarkdownComponent, NzButtonModule],\n  template: `\n    <div #scrollContainer class=\"markdown-demo-chat markdown-demo-sources\">\n      <div class=\"markdown-demo-actions\">\n        <button nz-button type=\"button\" (click)=\"reRender()\">Re-Render</button>\n      </div>\n\n      <nx-bubble [content]=\"content()\" [messageRender]=\"messageTpl\" variant=\"outlined\" />\n    </div>\n\n    <ng-template #messageTpl let-content=\"content\">\n      <nx-markdown [content]=\"content\" [components]=\"{ sup: supTpl }\" paragraphTag=\"div\" />\n    </ng-template>\n\n    <ng-template #supTpl let-textContent=\"textContent\">\n      <a\n        class=\"ant-sources ant-sources-inline markdown-demo-source\"\n        [href]=\"getSource(textContent).url\"\n        [attr.title]=\"getSource(textContent).description || getSource(textContent).title\"\n        target=\"_blank\"\n        rel=\"noreferrer\"\n      >\n        <span class=\"ant-sources ant-sources-title-wrapper\">\n          <span class=\"ant-sources-title\">{{ textContent }}</span>\n        </span>\n      </a>\n    </ng-template>\n  `,\n  styles: `\n    .markdown-demo-chat {\n      display: flex;\n      flex-direction: column;\n      gap: 8px;\n      overflow: auto;\n    }\n\n    .markdown-demo-sources {\n      height: 240px;\n    }\n\n    .markdown-demo-actions {\n      display: flex;\n      justify-content: flex-end;\n    }\n\n    .markdown-demo-source {\n      display: inline-flex;\n      color: rgb(0 0 0 / 45%);\n      text-decoration: none;\n      vertical-align: baseline;\n    }\n\n    .markdown-demo-source:hover {\n      color: #1677ff;\n    }\n\n    .markdown-demo-source .ant-sources-title-wrapper {\n      display: flex;\n      align-items: center;\n      width: fit-content;\n      height: 16px;\n      padding-block: 0;\n      padding-inline: 6px;\n      margin-block: 0;\n      margin-inline: 4px;\n      color: inherit;\n      font-size: 12px;\n      font-weight: 400;\n      line-height: 16px;\n      background: rgb(0 0 0 / 6%);\n      border-radius: 8px;\n    }\n  `,\n  changeDetection: ChangeDetectionStrategy.OnPush\n})\nexport class NxDemoXMarkdownComponentsSourcesComponent {\n  readonly destroyRef = inject(DestroyRef);\n  readonly isBrowser = isPlatformBrowser(inject(PLATFORM_ID));\n  readonly scrollContainer = viewChild<ElementRef<HTMLElement>>('scrollContainer');\n  readonly index = signal(0);\n  readonly content = computed(() => CONTENT.slice(0, this.index()));\n  timer: ReturnType<typeof setTimeout> | null = null;\n\n  constructor() {\n    if (this.isBrowser) {\n      this.renderStream();\n    }\n    this.destroyRef.onDestroy(() => this.clearTimer());\n  }\n\n  reRender(): void {\n    this.clearTimer();\n    this.index.set(0);\n    this.renderStream();\n  }\n\n  getSource(textContent: string): { title: string; url: string; description?: string } {\n    return SOURCE_ITEMS[textContent.trim()] ?? SOURCE_ITEMS[1];\n  }\n\n  renderStream(): void {\n    if (!this.isBrowser || this.index() >= CONTENT.length) {\n      this.clearTimer();\n      return;\n    }\n\n    this.timer = setTimeout(() => {\n      this.index.update(index => Math.min(index + 5, CONTENT.length));\n      this.scrollToBottom();\n      this.renderStream();\n    }, 20);\n  }\n\n  scrollToBottom(): void {\n    queueMicrotask(() => {\n      const container = this.scrollContainer()?.nativeElement;\n      if (container && container.scrollHeight > container.clientHeight) {\n        container.scrollTo({ top: container.scrollHeight, behavior: 'smooth' });\n      }\n    });\n  }\n\n  clearTimer(): void {\n    if (this.timer) {\n      clearTimeout(this.timer);\n      this.timer = null;\n    }\n  }\n}\n"}
