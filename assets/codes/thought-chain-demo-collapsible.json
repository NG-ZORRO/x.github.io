class</span> <span class=\"token class-name\">NxDemoThoughtChainCollapsibleComponent</span> <span class=\"token keyword\">implements</span> <span class=\"token class-name\">OnInit</span> <span class=\"token punctuation\">{</span>\n  <span class=\"token decorator\"><span class=\"token at operator\">@</span><span class=\"token function\">ViewChild</span></span><span class=\"token punctuation\">(</span><span class=\"token string\">'createTaskContent'</span><span class=\"token punctuation\">,</span> <span class=\"token punctuation\">{</span> <span class=\"token keyword\">static</span><span class=\"token operator\">:</span> <span class=\"token boolean\">true</span> <span class=\"token punctuation\">}</span><span class=\"token punctuation\">)</span> createTaskContentRef<span class=\"token operator\">!</span><span class=\"token operator\">:</span> TemplateRef<span class=\"token operator\">&lt;</span><span class=\"token keyword\">void</span><span class=\"token operator\">></span><span class=\"token punctuation\">;</span>\n  <span class=\"token decorator\"><span class=\"token at operator\">@</span><span class=\"token function\">ViewChild</span></span><span class=\"token punctuation\">(</span><span class=\"token string\">'checkTaskContent'</span><span class=\"token punctuation\">,</span> <span class=\"token punctuation\">{</span> <span class=\"token keyword\">static</span><span class=\"token operator\">:</span> <span class=\"token boolean\">true</span> <span class=\"token punctuation\">}</span><span class=\"token punctuation\">)</span> checkTaskContentRef<span class=\"token operator\">!</span><span class=\"token operator\">:</span> TemplateRef<span class=\"token operator\">&lt;</span><span class=\"token keyword\">void</span><span class=\"token operator\">></span><span class=\"token punctuation\">;</span>\n\n  nxItems<span class=\"token operator\">:</span> NxThoughtChainItem<span class=\"token punctuation\">[</span><span class=\"token punctuation\">]</span> <span class=\"token operator\">=</span> <span class=\"token punctuation\">[</span><span class=\"token punctuation\">]</span><span class=\"token punctuation\">;</span>\n\n  <span class=\"token function\">ngOnInit</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span><span class=\"token operator\">:</span> <span class=\"token keyword\">void</span> <span class=\"token punctuation\">{</span>\n    <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span>nxItems <span class=\"token operator\">=</span> <span class=\"token punctuation\">[</span>\n      <span class=\"token punctuation\">{</span>\n        key<span class=\"token operator\">:</span> <span class=\"token string\">'create_task'</span><span class=\"token punctuation\">,</span>\n        title<span class=\"token operator\">:</span> <span class=\"token string\">'Create Task: Write New Component'</span><span class=\"token punctuation\">,</span>\n        description<span class=\"token operator\">:</span> <span class=\"token string\">'Execute files needed for creating new component'</span><span class=\"token punctuation\">,</span>\n        collapsible<span class=\"token operator\">:</span> <span class=\"token boolean\">true</span><span class=\"token punctuation\">,</span>\n        content<span class=\"token operator\">:</span> <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span>createTaskContentRef<span class=\"token punctuation\">,</span>\n        status<span class=\"token operator\">:</span> <span class=\"token string\">'success'</span>\n      <span class=\"token punctuation\">}</span><span class=\"token punctuation\">,</span>\n      <span class=\"token punctuation\">{</span>\n        key<span class=\"token operator\">:</span> <span class=\"token string\">'check_task'</span><span class=\"token punctuation\">,</span>\n        title<span class=\"token operator\">:</span> <span class=\"token string\">'Checking Task Execution Steps'</span><span class=\"token punctuation\">,</span>\n        description<span class=\"token operator\">:</span> <span class=\"token string\">'Verify overall task execution logic and feasibility'</span><span class=\"token punctuation\">,</span>\n        content<span class=\"token operator\">:</span> <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span>checkTaskContentRef<span class=\"token punctuation\">,</span>\n        status<span class=\"token operator\">:</span> <span class=\"token string\">'loading'</span>\n      <span class=\"token punctuation\">}</span>\n    <span class=\"token punctuation\">]</span><span class=\"token punctuation\">;</span>\n  <span class=\"token punctuation\">}</span>\n<span class=\"token punctuation\">}</span>\n","rawCode":"import { Component, OnInit, TemplateRef, ViewChild } from '@angular/core';\n\nimport { NzCardComponent } from 'ng-zorro-antd/card';\n\nimport { NxThoughtChainItem, NxThoughtChainModule } from 'ng-zorro-x/thought-chain';\n\n@Component({\n  selector: 'nx-demo-thought-chain-collapsible',\n  imports: [NxThoughtChainModule, NzCardComponent],\n  template: `\n    <nz-card style=\"width: 500px\">\n      <nx-thought-chain [items]=\"nxItems\" [defaultExpandedKeys]=\"['create_task']\" />\n    </nz-card>\n\n    <ng-template #createTaskContent>\n      <div style=\"display: flex; flex-direction: column; gap: 8px;\">\n        <span style=\"color: rgba(0, 0, 0, 0.45);\">Creating folder for new component</span>\n        <nx-thought-chain-item variant=\"solid\" icon=\"code\" title=\"Executing command\" description=\"mkdir -p component\" />\n        <span style=\"color: rgba(0, 0, 0, 0.45);\">Creating files needed for new component</span>\n        <nx-thought-chain-item variant=\"solid\" icon=\"edit\" title=\"Creating file\" description=\"component/index.tsx\" />\n        <span style=\"color: rgba(0, 0, 0, 0.45);\">Creating Chinese description file for new component</span>\n        <nx-thought-chain-item\n          variant=\"solid\"\n          icon=\"edit\"\n          title=\"Creating file\"\n          description=\"component/index.zh-CN.md\"\n        />\n        <span style=\"color: rgba(0, 0, 0, 0.45);\">Creating English description file for new component</span>\n        <nx-thought-chain-item\n          variant=\"solid\"\n          icon=\"edit\"\n          title=\"Creating file\"\n          description=\"component/index.en-US.md\"\n        />\n      </div>\n    </ng-template>\n\n    <ng-template #checkTaskContent>\n      <div style=\"display: flex; flex-direction: column; gap: 8px;\">\n        <nx-thought-chain-item variant=\"solid\" status=\"success\" title=\"Folder created\" description=\"component\" />\n        <nx-thought-chain-item\n          variant=\"solid\"\n          status=\"success\"\n          title=\"File created\"\n          description=\"component/index.tsx\"\n        />\n        <nx-thought-chain-item\n          variant=\"solid\"\n          status=\"success\"\n          title=\"File created\"\n          description=\"component/index.zh-CN.md\"\n        />\n        <nx-thought-chain-item\n          variant=\"solid\"\n          status=\"success\"\n          title=\"File created\"\n          description=\"component/index.en-US.md\"\n        />\n      </div>\n    </ng-template>\n  `\n})\nexport class NxDemoThoughtChainCollapsibleComponent implements OnInit {\n  @ViewChild('createTaskContent', { static: true }) createTaskContentRef!: TemplateRef<void>;\n  @ViewChild('checkTaskContent', { static: true }) checkTaskContentRef!: TemplateRef<void>;\n\n  nxItems: NxThoughtChainItem[] = [];\n\n  ngOnInit(): void {\n    this.nxItems = [\n      {\n        key: 'create_task',\n        title: 'Create Task: Write New Component',\n        description: 'Execute files needed for creating new component',\n        collapsible: true,\n        content: this.createTaskContentRef,\n        status: 'success'\n      },\n      {\n        key: 'check_task',\n        title: 'Checking Task Execution Steps',\n        description: 'Verify overall task execution logic and feasibility',\n        content: this.checkTaskContentRef,\n        status: 'loading'\n      }\n    ];\n  }\n}\n"}
