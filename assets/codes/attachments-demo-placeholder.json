ngular/core';\n\nimport { NzButtonModule } from 'ng-zorro-antd/button';\nimport { NzFlexModule } from 'ng-zorro-antd/flex';\nimport { NzResultModule } from 'ng-zorro-antd/result';\nimport { NzUploadChangeParam } from 'ng-zorro-antd/upload';\n\nimport { NxAttachment, NxAttachmentsModule, NxPlaceholder, NxPlaceholderType } from 'ng-zorro-x/attachments';\n\nconst PRESET_FILES: NxAttachment[] = [\n  {\n    uid: '1',\n    name: 'uploading file.xlsx',\n    status: 'uploading',\n    percent: 93\n  },\n  {\n    uid: '2',\n    name: 'uploaded file.docx',\n    status: 'done',\n    size: 123456,\n    description: 'Customize description'\n  },\n  {\n    uid: '3',\n    name: 'upload error with long text file name.zip',\n    status: 'error',\n    response: 'Server Error 500'\n  },\n  {\n    uid: '4',\n    name: 'image uploading preview.png',\n    status: 'uploading',\n    percent: 33,\n    thumbUrl: 'https://zos.alipayobjects.com/rmsportal/jkjgkEfvpUPVyRjUImniVslZfWPnJuuZ.png'\n  },\n  {\n    uid: '5',\n    name: 'image done preview.png',\n    status: 'done',\n    size: 123456,\n    thumbUrl: 'https://zos.alipayobjects.com/rmsportal/jkjgkEfvpUPVyRjUImniVslZfWPnJuuZ.png'\n  },\n  {\n    uid: '6',\n    name: 'image error preview.png',\n    status: 'error',\n    response: 'Server Error 500',\n    thumbUrl: 'https://zos.alipayobjects.com/rmsportal/jkjgkEfvpUPVyRjUImniVslZfWPnJuuZ.png'\n  }\n];\n\n@Component({\n  selector: 'nx-demo-attachments-placeholder',\n  imports: [NxAttachmentsModule, NzButtonModule, NzFlexModule, NzResultModule],\n  template: `\n    <div class=\"wrapper\" nz-flex nzVertical nzGap=\"middle\">\n      <div class=\"box\">\n        <nx-attachments\n          [items]=\"items()\"\n          [beforeUpload]=\"beforeUpload\"\n          [placeholder]=\"getPlaceholderFn(objectPlaceholder)\"\n          (fileChange)=\"onChange($event)\"\n        />\n      </div>\n      <div class=\"box\">\n        <nx-attachments\n          [items]=\"items()\"\n          [beforeUpload]=\"beforeUpload\"\n          [placeholder]=\"getPlaceholderFn(placeholder)\"\n          (fileChange)=\"onChange($event)\"\n        />\n        <ng-template #placeholder>\n          <nz-result\n            nzTitle=\"Custom Placeholder Node\"\n            nzSubTitle=\"Support file type: image, video, audio, document, etc.\"\n          >\n            <div nz-result-extra>\n              <button nz-button nzType=\"primary\">Do Upload</button>\n            </div>\n            <div nz-result-icon>\n              <nz-icon nzType=\"cloud-upload\" />\n            </div>\n          </nz-result>\n        </ng-template>\n      </div>\n\n      <nz-flex nzGap=\"middle\">\n        <button nz-button nzType=\"primary\" style=\"flex: 1\" [disabled]=\"items().length > 0\" (click)=\"fillFiles()\">\n          Fill Files\n        </button>\n        <button nz-button style=\"flex: 1\" [disabled]=\"items().length === 0\" (click)=\"resetFiles()\">\n          Reset Files\n        </button>\n      </nz-flex>\n    </div>\n  `,\n  styles: `\n    :host .wrapper {\n      padding: 16px;\n      background: rgba(0, 0, 0, 0.04);\n    }\n    :host .box {\n      border-radius: 4px;\n      overflow: hidden;\n      background: #fff;\n    }\n  `\n})\nexport class NxDemoAttachmentsPlaceholderComponent {\n  readonly items = signal<NxAttachment[]>([]);\n\n  readonly getPlaceholderFn = (inlinePlaceholder: NxPlaceholder): NxPlaceholderType => {\n    return (type: 'inline' | 'drop') =>\n      type === 'drop'\n        ? {\n            title: 'Drop file here'\n          }\n        : inlinePlaceholder;\n  };\n\n  readonly objectPlaceholder: NxPlaceholder = {\n    icon: 'cloud-upload',\n    title: 'Click or Drop files here',\n    description: 'Support file type: image, video, audio, document, etc.'\n  };\n\n  readonly beforeUpload = (): boolean => false;\n\n  onChange(info: NzUploadChangeParam): void {\n    this.items.set(info.fileList as NxAttachment[]);\n  }\n\n  fillFiles(): void {\n    this.items.set(PRESET_FILES);\n  }\n\n  resetFiles(): void {\n    this.items.set([]);\n  }\n}\n"}
