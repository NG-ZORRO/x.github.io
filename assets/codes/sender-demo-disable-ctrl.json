n punctuation\">}</span>\n\n  <span class=\"token function\">submit</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span><span class=\"token operator\">:</span> <span class=\"token keyword\">void</span> <span class=\"token punctuation\">{</span>\n    <span class=\"token keyword\">if</span> <span class=\"token punctuation\">(</span><span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span><span class=\"token function\">submitDisabled</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">)</span> <span class=\"token keyword\">return</span><span class=\"token punctuation\">;</span>\n    <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span>value<span class=\"token punctuation\">.</span><span class=\"token function\">set</span><span class=\"token punctuation\">(</span><span class=\"token string\">''</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n    <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span><span class=\"token function\">sender</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span><span class=\"token operator\">?.</span><span class=\"token function\">clear</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n    <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span>items<span class=\"token punctuation\">.</span><span class=\"token function\">set</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">[</span><span class=\"token punctuation\">]</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n    <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span>loading<span class=\"token punctuation\">.</span><span class=\"token function\">set</span><span class=\"token punctuation\">(</span><span class=\"token boolean\">true</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n    <span class=\"token function\">setTimeout</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span> <span class=\"token operator\">=></span> <span class=\"token punctuation\">{</span>\n      <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span>loading<span class=\"token punctuation\">.</span><span class=\"token function\">set</span><span class=\"token punctuation\">(</span><span class=\"token boolean\">false</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n    <span class=\"token punctuation\">}</span><span class=\"token punctuation\">,</span> <span class=\"token number\">1000</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n  <span class=\"token punctuation\">}</span>\n\n  <span class=\"token function\">cancel</span><span class=\"token punctuation\">(</span><span class=\"token punctuation\">)</span><span class=\"token operator\">:</span> <span class=\"token keyword\">void</span> <span class=\"token punctuation\">{</span>\n    <span class=\"token keyword\">this</span><span class=\"token punctuation\">.</span>loading<span class=\"token punctuation\">.</span><span class=\"token function\">set</span><span class=\"token punctuation\">(</span><span class=\"token boolean\">false</span><span class=\"token punctuation\">)</span><span class=\"token punctuation\">;</span>\n  <span class=\"token punctuation\">}</span>\n<span class=\"token punctuation\">}</span>\n","rawCode":"import { Component, ElementRef, computed, signal, viewChild } from '@angular/core';\n\nimport { NzBadgeModule } from 'ng-zorro-antd/badge';\nimport { NzButtonModule } from 'ng-zorro-antd/button';\nimport { NzFlexModule } from 'ng-zorro-antd/flex';\nimport { NzIconModule } from 'ng-zorro-antd/icon';\nimport { NzTooltipModule } from 'ng-zorro-antd/tooltip';\nimport { NzUploadChangeParam } from 'ng-zorro-antd/upload';\n\nimport { NxAttachment, NxAttachmentsModule, NxPlaceholderType } from 'ng-zorro-x/attachments';\nimport { NxSenderComponent, NxSenderModule } from 'ng-zorro-x/sender';\n\n@Component({\n  selector: 'nx-demo-sender-disable-ctrl',\n  imports: [\n    NzBadgeModule,\n    NzButtonModule,\n    NzFlexModule,\n    NzIconModule,\n    NzTooltipModule,\n    NxAttachmentsModule,\n    NxSenderModule\n  ],\n  template: `\n    <div nz-flex nzAlign=\"end\" class=\"sender-disable-ctrl-wrapper\">\n      <nx-sender\n        #sender=\"nxSender\"\n        submitType=\"enter\"\n        placeholder=\"Enter to send message\"\n        [header]=\"headerTpl\"\n        [actions]=\"actionsTpl\"\n        [value]=\"value()\"\n        (valueChange)=\"value.set($event)\"\n        (submitSend)=\"submit()\"\n      >\n        <nz-badge nx-sender-prefix [nzDot]=\"items().length > 0 && !open()\">\n          <button nz-button nzType=\"text\" (click)=\"open.set(!open())\">\n            <nz-icon nzType=\"paper-clip\" class=\"sender-disable-ctrl-prefix-icon\" />\n          </button>\n        </nz-badge>\n      </nx-sender>\n    </div>\n\n    <ng-template #headerTpl>\n      <nx-sender-header\n        title=\"Attachments\"\n        class=\"sender-disable-ctrl-header\"\n        [open]=\"open()\"\n        (openChange)=\"open.set($event)\"\n      >\n        <nx-attachments\n          [items]=\"items()\"\n          [beforeUpload]=\"beforeUpload\"\n          [placeholder]=\"placeholder\"\n          [getDropContainer]=\"getDropContainer\"\n          (fileChange)=\"onChange($event)\"\n        />\n      </nx-sender-header>\n    </ng-template>\n\n    <ng-template #actionsTpl>\n      @if (loading()) {\n        <button nz-button nzType=\"text\" nzShape=\"circle\" nz-tooltip nzTooltipTitle=\"Click to cancel\" (click)=\"cancel()\">\n          <nz-icon nzType=\"loading\" />\n        </button>\n      } @else {\n        <button nz-button nzType=\"primary\" nzShape=\"circle\" [disabled]=\"submitDisabled()\" (click)=\"submit()\">\n          <nz-icon nzType=\"arrow-up\" />\n        </button>\n      }\n    </ng-template>\n  `,\n  styles: `\n    .sender-disable-ctrl-wrapper {\n      height: 350px;\n    }\n\n    .sender-disable-ctrl-prefix-icon {\n      font-size: 16px;\n    }\n\n    .sender-disable-ctrl-header {\n      padding: 0;\n    }\n  `\n})\nexport class NxDemoSenderDisableCtrlComponent {\n  readonly sender = viewChild<NxSenderComponent>('sender');\n  readonly senderElementRef = viewChild('sender', { read: ElementRef });\n\n  readonly value = signal('');\n  readonly loading = signal(false);\n  readonly open = signal(false);\n  readonly items = signal<NxAttachment[]>([]);\n  readonly submitDisabled = computed(() => this.items().length === 0 && !this.value() && !this.loading());\n\n  readonly placeholder: NxPlaceholderType = type =>\n    type === 'drop'\n      ? { title: 'Drop file here' }\n      : {\n          icon: 'cloud-upload',\n          title: 'Upload files',\n          description: 'Click or drag files to this area to upload'\n        };\n\n  readonly getDropContainer = (): HTMLElement | null => this.senderElementRef()?.nativeElement ?? null;\n\n  readonly beforeUpload = (): boolean => false;\n\n  onChange(info: NzUploadChangeParam): void {\n    this.items.set(\n      info.fileList.map(item => {\n        if (item.uid === info.file.uid && info.file.status !== 'removed' && item.originFileObj) {\n          if (item.url?.startsWith('blob:')) {\n            URL.revokeObjectURL(item.url);\n          }\n          return { ...item, url: URL.createObjectURL(item.originFileObj) };\n        }\n        return item;\n      }) as NxAttachment[]\n    );\n  }\n\n  submit(): void {\n    if (this.submitDisabled()) return;\n    this.value.set('');\n    this.sender()?.clear();\n    this.items.set([]);\n    this.loading.set(true);\n    setTimeout(() => {\n      this.loading.set(false);\n    }, 1000);\n  }\n\n  cancel(): void {\n    this.loading.set(false);\n  }\n}\n"}
